{
  "_comment": "Default settings for the retrieval benchmark pipeline. All overridable via CLI.",

  "paths": {
    "clean_jsonl":           "data/processed/clean.jsonl",
    "test_jsonl":            "data/processed/test.jsonl",
    "topic_assignments":     "production_pipeline/p02_eda/experiments/topic_assignments_all.json",
    "retrieval_configs":     "configs/retrieval_configs.json",
    "models_config":         "configs/models.json",
    "experiments_dir":       "experiments",
    "embeddings_cache_dir":  "experiments/embeddings"
  },

  "qdrant": {
    "host": "localhost",
    "port": 6333,
    "distance": "Cosine"
  },

  "elasticsearch": {
    "host": "http://localhost:9200",
    "index": "faqs",
    "request_timeout": 30,
    "bulk_timeout": 60
  },

  "benchmark": {
    "top_k": 10,
    "default_search_type": "vector"
  },

  "ingestion": {
    "batch_size": 100,
    "encode_batch_size": 64,
    "show_progress_bar": true
  },

  "course_name_map": {
    "ml-zoomcamp":   "machine-learning-zoomcamp",
    "de-zoomcamp":   "data-engineering-zoomcamp",
    "mlops-zoomcamp": "mlops-zoomcamp",
    "llm-zoomcamp":  "llm-zoomcamp"
  },

  "production_model": "BAAI/bge-base-en-v1.5"
}